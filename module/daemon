#!/system/bin/sh
# The JVM control plane ships as a zip container called `payload.bin` whose root holds
# `classes.dex`. `app_process` takes any zip as its classpath whatever the file is named, so the
# module directory carries neither a bare `classes.dex` nor a `service.apk`.
MODDIR=$1
CLASSPATH="$MODDIR/payload.bin"
if [ ! -f "$CLASSPATH" ]; then
    echo "Error: payload.bin not found in $MODDIR"
    exit 1
fi
exec /system/bin/app_process -Djava.class.path="$CLASSPATH" "$MODDIR" --nice-name=TrickyStoreOSS io.github.beakthoven.TrickyStoreOSS.MainKt
